[Unit]
Description=ymd: Yandex Music player service
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
WorkingDirectory=%h/Projects/omarchy-yandex-music
ExecStart=/usr/bin/python -m ymd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
